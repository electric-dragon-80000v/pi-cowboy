{
  "name": "pi-cowboy",
  "version": "1.0.0",
  "type": "module",
  "description": "Agent orchestrator for pi: each subagent runs as its own pi process in a background Herdr pane, isolated by a copy-on-write git worktree.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "pi-coding-agent",
    "pi-extension",
    "subagents",
    "herdr",
    "ai",
    "agents"
  ],
  "license": "MIT",
  "author": "electric-dragon-80000v",
  "homepage": "https://github.com/electric-dragon-80000v/pi-cowboy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electric-dragon-80000v/pi-cowboy.git"
  },
  "bugs": {
    "url": "https://github.com/electric-dragon-80000v/pi-cowboy/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src/",
    "agents/",
    "orchestrators/",
    "docs/*.md",
    "docs/assets/*.png",
    "!docs/assets/logo.png",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "prettier --write src/ test/ scripts/ lint/ docs/",
    "format:check": "prettier --check src/ test/ scripts/ lint/ docs/",
    "typecheck": "tsc --noEmit",
    "find-unused": "node --disable-warning=ExperimentalWarning scripts/find-unused.ts",
    "build": "tsc -p tsconfig.build.json",
    "pretest:integration": "npm run build",
    "pretest:integration-no-cow": "npm run build",
    "pretest:integration-cow": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration-no-cow --project integration-cow",
    "test:integration-no-cow": "vitest run --project integration-no-cow",
    "test:integration-cow": "vitest run --project integration-cow",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": ">=0.85.0",
    "@earendil-works/pi-coding-agent": ">=0.85.0",
    "@earendil-works/pi-tui": ">=0.85.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "^24.0.0",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.10.0",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "prettier": "^3.9.6",
    "typebox": "^1.3.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "caller-id": "^0.1.0",
    "crockford-base32": "^2.1.0",
    "mustache": "^4.2.0",
    "smol-toml": "^1.8.0",
    "zod": "^4.6.5"
  }
}
